// Advanced conditionals and error tolerance
// Demonstrates: else if chains, logical operators (&&, ||, !, parentheses),
//               and the "!" error-tolerance marker
// Run with:
//   construct Constfile-advanced-control deploy -e os=windows -e version=3
//   construct Constfile-advanced-control matrix

var os = linux
var version = 2
var env = dev

deploy {
    if "&os" == "windows" && "&version" >= "3" {
        $ echo "modern windows build"
    } else if "&os" == "windows" {
        $ echo "legacy windows build"
    } else if "&os" == "linux" || "&os" == "darwin" {
        $ echo "posix build for &os"
    } else {
        $ echo "unsupported os: &os"
    }

    // Parenthesized negation.
    if !("&env" == "prod") {
        $ echo "non-prod: skipping production safeguards"
    }

    // Error tolerance: a failing step doesn't abort the build.
    ! kubectl rollout status deployment/app
    $ echo "deploy complete"
}

matrix {
    for target in windows/amd64, windows/arm64, linux/amd64 {
        if "&target" contains "windows" && "&target" contains "amd64" {
            $ echo "primary windows target: &target"
        } else if "&target" contains "windows" {
            $ echo "secondary windows target: &target"
        } else {
            $ echo "linux target: &target"
        }
    }
}
