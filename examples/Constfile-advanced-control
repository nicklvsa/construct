// Advanced conditionals and error tolerance
// Demonstrates: else if chains, logical operators (&&, ||, !, parentheses),
//               the "!" error-tolerance marker, build matrices, loop control,
//               single-line blocks, built-in file-test functions, loop
//               index, numeric ranges, and the literal-ref escape hatch
// Run with:
//   construct Constfile-advanced-control deploy -e os=windows -e version=3
//   construct Constfile-advanced-control matrix
//   construct Constfile-advanced-control build_matrix
//   construct Constfile-advanced-control artifacts
//   construct Constfile-advanced-control literals

var os = linux
var version = 2
var env = dev

deploy {
    if "&os" == "windows" && "&version" >= "3" {
        $ echo "modern windows build"
    } else if "&os" == "windows" {
        $ echo "legacy windows build"
    } else if "&os" == "linux" || "&os" == "darwin" {
        $ echo "posix build for &os"
    } else {
        $ echo "unsupported os: &os"
    }

    // Parenthesized negation.
    if !("&env" == "prod") {
        $ echo "non-prod: skipping production safeguards"
    }

    // Error tolerance: a failing step doesn't abort the build.
    ! kubectl rollout status deployment/app
    $ echo "deploy complete"
}

matrix {
    for target in windows/amd64, windows/arm64, linux/amd64 {
        if "&target" contains "windows" && "&target" contains "amd64" {
            $ echo "primary windows target: &target"
        } else if "&target" contains "windows" {
            $ echo "secondary windows target: &target"
        } else {
            $ echo "linux target: &target"
        }
    }
}

build_matrix {
    matrix os in windows, linux; arch in amd64, arm64 {
        continue if "&os" == "windows" && "&arch" == "arm64"
        $ echo "building &os/&arch"
    }
}

// Built-in file-test functions (evaluated by construct, never the shell),
// single-line blocks, loop index, and numeric ranges.
artifacts {
    for i, f in app.exe, lib.dylib, lib.so {
        $ echo "[&i] artifact: &f"
    }
    for i in 1..3 {
        $ echo "attempt &i"
    }
    if exists("README.md") { $ echo "docs exist" } else { $ echo "no docs" }
    if missing("dist/app.exe") {
        $ echo "release not built yet"
    }
    if glob("*.md") {
        $ echo "found markdown docs"
    }
}

// @ENV refs resolve in shell lines when set; "\&" and "\@" escape literals.
literals {
    $ echo "home: @HOME"
    $ echo "literal @HOME and \&name"
}
