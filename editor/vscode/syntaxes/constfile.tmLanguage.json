{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Constfile",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#state-declaration"
		},
		{
			"include": "#variable-declaration"
		},
		{
			"include": "#command-header"
		},
		{
			"include": "#body-content"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.constfile",
					"match": "(?<![A-Za-z0-9_:])\\/\\/.*$"
				},
				{
					"name": "comment.line.number-sign.constfile",
					"match": "(?<![A-Za-z0-9_])#.*$"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.constfile",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.constfile",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.constfile",
			"match": "\\b\\d+\\b"
		},
		"keywords": {
			"patterns": [
				{
					"comment": "keyword modifier value: parallel<4>, retry<3, 2s>, lock<5m>, switch<strict>, timeout<30s>",
					"match": "\\b(parallel|lock|retry|switch|timeout)(<)([^>]+)(>)",
					"captures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "punctuation.definition.modifier.constfile"
						},
						"3": {
							"name": "constant.other.modifier.constfile"
						},
						"4": {
							"name": "punctuation.definition.modifier.constfile"
						}
					}
				},
				{
					"name": "keyword.control.constfile",
					"match": "\\b(manual|opt|parallel|if|else|for|matrix|in|contains|starts_with|ends_with|matches|import|continue|break|exists|missing|glob|require|produces|container|env|invoke|fail|onfail|global|require_env|retry|onchange|switch|case|default|lock|state|confirm|prompt|input|timeout)\\b"
				},
				{
					"comment": "Builtin with modifier: rm<kill> path (optionally after timeout/retry and/or !)",
					"match": "^\\s*(?:(retry|timeout)(<)([^>]+)(>)\\s+)*(?:(!)\\s*)?(cp|rm|mkdir|touch|download|extract)(<)([^>\\s]+)(>)(?=\\s|$)",
					"captures": {
						"1": { "name": "keyword.control.constfile" },
						"2": { "name": "punctuation.definition.modifier.constfile" },
						"3": { "name": "constant.other.modifier.constfile" },
						"4": { "name": "punctuation.definition.modifier.constfile" },
						"5": { "name": "keyword.operator.error-tolerant.constfile" },
						"6": { "name": "support.function.builtin.constfile" },
						"7": { "name": "punctuation.definition.modifier.constfile" },
						"8": { "name": "constant.other.modifier.constfile" },
						"9": { "name": "punctuation.definition.modifier.constfile" }
					}
				},
				{
					"comment": "Builtin cross-platform commands (bare names in bodies)",
					"match": "^\\s*(?:(retry|timeout)(<)([^>]+)(>)\\s+)*(?:(!)\\s*)?(cp|rm|mkdir|touch|download|extract)(?=\\s|$)",
					"captures": {
						"1": { "name": "keyword.control.constfile" },
						"2": { "name": "punctuation.definition.modifier.constfile" },
						"3": { "name": "constant.other.modifier.constfile" },
						"4": { "name": "punctuation.definition.modifier.constfile" },
						"5": { "name": "keyword.operator.error-tolerant.constfile" },
						"6": { "name": "support.function.builtin.constfile" }
					}
				},
				{
					"comment": "Expression function calls (var values, conditions)",
					"name": "support.function.constfile",
					"match": "\\b(basename|dirname|ext|stem|upper|lower|trim|replace|sprintf|length|abs|min|max|date|uuid|file|lines|sha256|len|sort|uniq|join|split|env|state)\\s*(?=\\()"
				}
			]
		},
		"state-ref": {
			"patterns": [
				{
					"name": "support.variable.state.constfile",
					"match": "(?:@state|state)\\s*\\(\\s*\"([^\"]+)\"\\s*\\)",
					"captures": {
						"1": {
							"name": "string.quoted.double.constfile"
						}
					}
				}
			]
		},
		"list-literal": {
			"name": "meta.list.constfile",
			"begin": "\\[",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.list.begin.constfile"
				}
			},
			"end": "\\]",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.list.end.constfile"
				}
			},
			"patterns": [
				{
					"include": "#var-ref"
				},
				{
					"include": "#env-ref"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#numbers"
				},
				{
					"name": "punctuation.separator.comma.constfile",
					"match": "(,)"
				},
				{
					"name": "string.interpolated.constfile",
					"match": "[^\\],]*"
				}
			]
		},
		"env-ref": {
			"patterns": [
				{
					"name": "support.variable.constfile",
					"match": "(?<![A-Za-z0-9_.-])(@)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": {
							"name": "punctuation.definition.variable.constfile"
						},
						"2": {
							"name": "variable.other.readwrite.constfile"
						}
					}
				}
			]
		},
		"var-ref": {
			"patterns": [
				{
					"name": "variable.other.readwrite.constfile",
					"match": "&[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)+"
				},
				{
					"name": "variable.other.readwrite.constfile",
					"match": "&[A-Za-z_][A-Za-z0-9_]*\\.\\d+"
				},
				{
					"name": "variable.other.readwrite.constfile",
					"match": "&[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},
		"shell-prefix": {
			"comment": "Optional timeout/retry modifiers keep their own scopes via captures.",
			"match": "^\\s*(?:(retry|timeout)(<)([^>]+)(>)\\s+)*(\\$)\\s",
			"captures": {
				"1": { "name": "keyword.control.constfile" },
				"2": { "name": "punctuation.definition.modifier.constfile" },
				"3": { "name": "constant.other.modifier.constfile" },
				"4": { "name": "punctuation.definition.modifier.constfile" },
				"5": { "name": "keyword.operator.shell.constfile" }
			}
		},
		"error-tolerant-prefix": {
			"match": "^\\s*(?:(retry|timeout)(<)([^>]+)(>)\\s+)*(?:\\$\\s*)?(!)(?=\\s)",
			"captures": {
				"1": { "name": "keyword.control.constfile" },
				"2": { "name": "punctuation.definition.modifier.constfile" },
				"3": { "name": "constant.other.modifier.constfile" },
				"4": { "name": "punctuation.definition.modifier.constfile" },
				"5": { "name": "keyword.operator.error-tolerant.constfile" }
			}
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.comparison.constfile",
					"match": "(&&|\\|\\||==|!=|>=|<=|>|<|!)"
				},
				{
					"name": "keyword.operator.arithmetic.constfile",
					"match": "([+\\-*/%])"
				},
				{
					"name": "keyword.operator.ternary.constfile",
					"match": "(\\?|:)"
				},
				{
					"name": "keyword.operator.assignment.constfile",
					"match": "(=)"
				},
				{
					"name": "keyword.operator.prerequisite.constfile",
					"match": "(<)"
				},
				{
					"name": "punctuation.separator.comma.constfile",
					"match": "(,)"
				},
				{
					"name": "punctuation.accessor.constfile",
					"match": "(\\.)"
				}
			]
		},
		"state-declaration": {
			"begin": "^\\s*(state)\\s+",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.state.constfile"
				}
			},
			"end": "$",
			"patterns": [
				{
					"name": "entity.name.function.constfile",
					"match": "([A-Za-z_][A-Za-z0-9_]*)"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#value-content"
				}
			]
		},
		"variable-declaration": {
			"begin": "^\\s*(var)\\s+",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.var.constfile"
				}
			},
			"end": "$",
			"patterns": [
				{
					"name": "entity.name.function.constfile",
					"match": "([A-Za-z_][A-Za-z0-9_]*)"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#value-content"
				}
			]
		},
		"command-header": {
			"comment": "Header patterns are scoped to unindented lines only: body lines must not match them (e.g. an 'in' condition would otherwise eat a quote and break brace pairing).",
			"begin": "^(?!(?:var|state|import)\\b)(?=[^\\s#/])",
			"end": "(?=\\{)|$",
			"patterns": [
				{
					"comment": "Cloud command: |name| (args) < prereqs in dir {",
					"match": "^(\\|)([A-Za-z_][A-Za-z0-9_-]*)(\\|)",
					"captures": {
						"1": {
							"name": "punctuation.definition.cloud.constfile"
						},
						"2": {
							"name": "entity.name.function.cloud.constfile"
						},
						"3": {
							"name": "punctuation.definition.cloud.constfile"
						}
					}
				},
				{
					"comment": "Default command: _ (args) < prereqs in dir {",
					"match": "^(_)(?=\\s*[(<{]|\\s+in\\s|\\s+produces\\s|\\s+onchange\\s|\\s+container\\s|\\s+timeout<)",
					"captures": {
						"1": {
							"name": "entity.name.function.default.constfile"
						}
					}
				},
				{
					"comment": "Manual entry point: manual name ... {",
					"match": "^(manual)\\s+([A-Za-z_][A-Za-z0-9_-]*)(?=\\s*[(<{]|\\s+in\\s|\\s+produces\\s|\\s+onchange\\s|\\s+container\\s|\\s+timeout<)",
					"captures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "entity.name.function.constfile"
						}
					}
				},
				{
					"comment": "Regular command: name (args) produces files < prereqs in dir {",
					"match": "^([A-Za-z_][A-Za-z0-9_-]*)(?=\\s*[(<{]|\\s+in\\s|\\s+produces\\s|\\s+onchange\\s|\\s+container\\s|\\s+timeout<)",
					"captures": {
						"1": {
							"name": "entity.name.function.constfile"
						}
					}
				},
				{
					"include": "#argument-list"
				},
				{
					"include": "#prerequisite-list"
				},
				{
					"comment": "in <dir> working directory modifier (stops before '<' so the prereq operator is tokenized separately)",
					"match": "\\b(in)\\s+([^{}|,<]+?)\\s*(?=\\{|,|<|\\s+(?:onchange|produces)\\s)",
					"captures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "string.interpolated.constfile"
						}
					}
				},
				{
					"comment": "container \"image\" modifier in headers",
					"match": "\\b(container)\\s+(\"[^\"]*\"|[^\\s{<,]+)",
					"captures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "string.interpolated.constfile"
						},
						"3": {
							"name": "keyword.control.constfile"
						},
						"4": {
							"name": "constant.numeric.constfile"
						}
					}
				},
				{
					"comment": "timeout<30s> modifier in headers",
					"match": "\\b(timeout)(<)([^>\\s,]+)(>)",
					"captures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "punctuation.definition.modifier.constfile"
						},
						"3": {
							"name": "constant.other.modifier.constfile"
						},
						"4": {
							"name": "punctuation.definition.modifier.constfile"
						}
					}
				},
				{
					"name": "keyword.control.constfile",
					"match": "\\bproduces\\b"
				},
				{
					"comment": "Trailing prereq names after the workdir modifier",
					"match": "(,)\\s*([A-Za-z_][A-Za-z0-9_-]*)",
					"captures": {
						"1": {
							"name": "punctuation.separator.comma.constfile"
						},
						"2": {
							"name": "entity.name.type.constfile"
						}
					}
				},
				{
					"name": "punctuation.definition.block.constfile",
					"match": "[{}]"
				}
			]
		},
		"argument-list": {
			"begin": "(\\()",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.parameters.begin.constfile"
				}
			},
			"end": "(\\))",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.parameters.end.constfile"
				}
			},
			"patterns": [
				{
					"include": "#keywords"
				},
				{
					"name": "variable.parameter.constfile",
					"match": "[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"include": "#operators"
				}
			]
		},
		"prerequisite-list": {
			"begin": "(<)",
			"beginCaptures": {
				"1": {
					"name": "keyword.operator.prerequisite.constfile"
				}
			},
			"end": "(?=\\s+in\\s+|\\s*{)",
			"patterns": [
				{
					"name": "entity.name.type.constfile",
					"match": "[A-Za-z_][A-Za-z0-9_-]*"
				},
				{
					"name": "punctuation.separator.comma.constfile",
					"match": "(,)"
				}
			]
		},
		"body-content": {
			"patterns": [
				{
					"include": "#variable-declaration"
				},
				{
					"comment": "switch <expr> { case v { } default { } } — keyword plus block",
					"name": "meta.block.switch.constfile",
					"begin": "^\\s*(switch)(<[^>\\s]*>)?\\s*([^{]+)(\\{)",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "constant.other.modifier.constfile"
						},
						"3": {
							"name": "string.interpolated.constfile"
						},
						"4": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"patterns": [
						{
							"comment": "case v1, v2 {",
							"match": "^\\s*(case)\\s+([^{]+)(\\{)",
							"captures": {
								"1": {
									"name": "keyword.control.constfile"
								},
								"2": {
									"name": "string.interpolated.constfile"
								},
								"3": {
									"name": "punctuation.definition.block.constfile"
								}
							}
						},
						{
							"comment": "default {",
							"match": "^\\s*(default)(\\s*)(\\{)",
							"captures": {
								"1": {
									"name": "keyword.control.constfile"
								},
								"3": {
									"name": "punctuation.definition.block.constfile"
								}
							}
						},
						{
							"include": "#body-content"
						}
					]
				},
				{
					"comment": "in <dir> { ... } scoped workdir block",
					"name": "meta.block.in.constfile",
					"begin": "^\\s*(in)\\s+([^{]+)(\\{)",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "string.interpolated.constfile"
						},
						"3": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"patterns": [
						{
							"include": "#body-content"
						}
					]
				},
				{
					"comment": "lock \"name\" { ... } mutual exclusion block",
					"name": "meta.block.lock.constfile",
					"begin": "^\\s*(lock)(<[^>\\s]*>)?\\s*([^{]+)(\\{)",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "constant.other.modifier.constfile"
						},
						"3": {
							"name": "string.interpolated.constfile"
						},
						"4": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"patterns": [
						{
							"include": "#body-content"
						}
					]
				},
				{
					"comment": "state name = value inside a body",
					"match": "^\\s*(state)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)(.*)$",
					"captures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"2": {
							"name": "entity.name.function.constfile"
						},
						"3": {
							"name": "keyword.operator.assignment.constfile"
						},
						"4": {
							"name": "string.interpolated.constfile"
						}
					}
				},
				{
					"comment": "as <name> output tag — must precede keywords so 'as' is claimed here",
					"match": "(\\s+)(as)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\s*$",
					"captures": {
						"2": {
							"name": "keyword.control.constfile"
						},
						"4": {
							"name": "entity.name.label.constfile"
						}
					}
				},
				{
					"comment": "env { KEY=value } block — scoped distinctly from shell text",
					"name": "meta.block.env.constfile",
					"begin": "^\\s*(env)(\\s*)(\\{)",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"3": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"patterns": [
						{
							"comment": "KEY=VALUE entry (single-line comma-separated and multi-line forms)",
							"name": "meta.env-entry.constfile",
							"match": "([A-Za-z_][A-Za-z0-9_]*)(\\s*)(=)(\\s*)([^,\\n}]*)(,?)",
							"captures": {
								"1": {
									"name": "variable.other.readwrite.constfile"
								},
								"3": {
									"name": "keyword.operator.assignment.constfile"
								},
								"5": {
									"name": "string.interpolated.constfile"
								},
								"6": {
									"name": "punctuation.separator.comma.constfile"
								}
							}
						},
						{
							"include": "#comments"
						},
						{
							"include": "#var-ref"
						},
						{
							"include": "#env-ref"
						},
						{
							"include": "#strings"
						}
					]
				},
				{
					"comment": "onfail { ... } cleanup block",
					"name": "meta.block.onfail.constfile",
					"begin": "^\\s*(onfail)(\\s*)(\\{)",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"3": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.block.constfile"
						}
					},
					"patterns": [
						{
							"include": "#body-content"
						}
					]
				},
				{
					"comment": "invoke <command> — keyword plus highlighted target name. Stops at the target so a trailing 'as <name>' capture falls to the as-tag pattern.",
					"match": "^\\s*(invoke)(\\s+)([A-Za-z_][A-Za-z0-9_.-]*)",
					"captures": {
						"1": {
							"name": "keyword.control.constfile"
						},
						"3": {
							"name": "entity.name.type.constfile"
						}
					}
				},
				{
					"include": "#keywords"
				},
				{
					"include": "#error-tolerant-prefix"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#shell-prefix"
				},
				{
					"include": "#comments"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#var-ref"
				},
				{
					"include": "#env-ref"
				},
				{
					"include": "#state-ref"
				},
				{
					"include": "#list-literal"
				},
				{
					"include": "#numbers"
				},
				{
					"name": "punctuation.definition.block.constfile",
					"match": "[{}]"
				},
				{
					"comment": "Body text — shell commands, paths, flags. Stops before 'as <name>' tag.",
					"name": "string.unquoted.constfile",
					"match": "[^{}\\s][^{}]*?(?=\\s+as\\s+[A-Za-z_][A-Za-z0-9_]*\\s*$|$)"
				}
			]
		},
		"value-content": {
			"patterns": [
				{
					"include": "#env-ref"
				},
				{
					"include": "#var-ref"
				},
				{
					"include": "#state-ref"
				},
				{
					"include": "#list-literal"
				},
				{
					"include": "#keywords"
				},
				{
					"comment": "$ prefix in a variable value creates a lazy command.",
					"name": "keyword.operator.shell.constfile",
					"match": "(\\$)"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#operators"
				}
			]
		}
	},
	"scopeName": "source.constfile"
}
