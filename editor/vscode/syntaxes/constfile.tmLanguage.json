{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Constfile",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#variable-declaration" },
		{ "include": "#command-header" },
		{ "include": "#body-content" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.constfile",
					"match": "(?<![A-Za-z0-9_:])\\/\\/.*$"
				},
				{
					"name": "comment.line.number-sign.constfile",
					"match": "(?<![A-Za-z0-9_])#.*$"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.constfile",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.constfile",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.constfile",
			"match": "\\b\\d+\\b"
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.constfile",
					"match": "\\b(opt|if|else|for|matrix|in|contains|import|continue|break|exists|missing|glob|require|produces|env|invoke)\\b"
				}
			]
		},
		"env-ref": {
			"patterns": [
				{
					"name": "support.variable.constfile",
					"match": "(?:^|\\s)(@)([A-Za-z_][A-Za-z0-9_]*)",
					"captures": {
						"1": { "name": "punctuation.definition.variable.constfile" },
						"2": { "name": "variable.other.readwrite.constfile" }
					}
				}
			]
		},
		"var-ref": {
			"patterns": [
				{
					"name": "variable.other.readwrite.constfile",
					"match": "&[A-Za-z_][A-Za-z0-9_]*\\.\\d+"
				},
				{
					"name": "variable.other.readwrite.constfile",
					"match": "&[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},
		"shell-prefix": {
			"name": "keyword.operator.shell.constfile",
			"match": "^\\s*(\\$)\\s"
		},
		"error-tolerant-prefix": {
			"name": "keyword.operator.error-tolerant.constfile",
			"match": "^\\s*(?:\\$\\s*)?(!)(?=\\s)"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.comparison.constfile",
					"match": "(&&|\\|\\||==|!=|>=|<=|>|<|!)"
				},
				{
					"name": "keyword.operator.assignment.constfile",
					"match": "(=)"
				},
				{
					"name": "keyword.operator.prerequisite.constfile",
					"match": "(<)"
				},
				{
					"name": "punctuation.separator.comma.constfile",
					"match": "(,)"
				},
				{
					"name": "punctuation.accessor.constfile",
					"match": "(\\.)"
				}
			]
		},
		"variable-declaration": {
			"begin": "^\\s*(var)\\s+",
			"beginCaptures": {
				"1": { "name": "keyword.control.var.constfile" }
			},
			"end": "$",
			"patterns": [
				{
					"name": "entity.name.function.constfile",
					"match": "([A-Za-z_][A-Za-z0-9_]*)"
				},
				{ "include": "#operators" },
				{ "include": "#value-content" }
			]
		},
		"command-header": {
			"patterns": [
				{
					"comment": "Cloud command: |name| (args) < prereqs in dir {",
					"match": "^(\\|)([A-Za-z_][A-Za-z0-9_-]*)(\\|)",
					"captures": {
						"1": { "name": "punctuation.definition.cloud.constfile" },
						"2": { "name": "entity.name.function.cloud.constfile" },
						"3": { "name": "punctuation.definition.cloud.constfile" }
					}
				},
				{
					"comment": "Default command: _ (args) < prereqs in dir {",
					"match": "^(_)(?=\\s*[(<{]|\\s+in\\s)",
					"captures": {
						"1": { "name": "entity.name.function.default.constfile" }
					}
				},
				{
					"comment": "Regular command: name (args) produces files < prereqs in dir {",
					"match": "^([A-Za-z_][A-Za-z0-9_-]*)(?=\\s*[(<{]|\\s+in\\s|\\s+produces\\s)",
					"captures": {
						"1": { "name": "entity.name.function.constfile" }
					}
				},
				{ "include": "#argument-list" },
				{ "include": "#prerequisite-list" },
				{
					"comment": "in <dir> working directory modifier (stops before '<' so the prereq operator is tokenized separately)",
					"match": "\\b(in)\\s+([^{}|,<]+?)\\s*(?=\\{|,|<)",
					"captures": {
						"1": { "name": "keyword.control.constfile" },
						"2": { "name": "string.interpolated.constfile" }
					}
				},
				{
					"name": "keyword.control.constfile",
					"match": "\\bproduces\\b"
				},
				{
					"comment": "Trailing prereq names after the workdir modifier",
					"match": "(,)\\s*([A-Za-z_][A-Za-z0-9_-]*)",
					"captures": {
						"1": { "name": "punctuation.separator.comma.constfile" },
						"2": { "name": "entity.name.type.constfile" }
					}
				},
				{
					"name": "punctuation.definition.block.constfile",
					"match": "[{}]"
				}
			]
		},
		"argument-list": {
			"begin": "(\\()",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.parameters.begin.constfile" }
			},
			"end": "(\\))",
			"endCaptures": {
				"1": { "name": "punctuation.definition.parameters.end.constfile" }
			},
			"patterns": [
				{ "include": "#keywords" },
				{
					"name": "variable.parameter.constfile",
					"match": "[A-Za-z_][A-Za-z0-9_]*"
				},
				{ "include": "#operators" }
			]
		},
		"prerequisite-list": {
			"begin": "(<)",
			"beginCaptures": {
				"1": { "name": "keyword.operator.prerequisite.constfile" }
			},
			"end": "(?=\\s+in\\s+|\\s*{)",
			"patterns": [
				{
					"name": "entity.name.type.constfile",
					"match": "[A-Za-z_][A-Za-z0-9_-]*"
				},
				{
					"name": "punctuation.separator.comma.constfile",
					"match": "(,)"
				}
			]
		},
		"body-content": {
			"patterns": [
				{ "include": "#variable-declaration" },
				{
					"comment": "as <name> output tag — must precede keywords so 'as' is claimed here",
					"match": "(\\s+)(as)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\s*$",
					"captures": {
						"2": { "name": "keyword.control.constfile" },
						"4": { "name": "entity.name.label.constfile" }
					}
				},
				{
					"comment": "env { KEY=value } block — scoped distinctly from shell text",
					"name": "meta.block.env.constfile",
					"begin": "^\\s*(env)(\\s*)(\\{)",
					"beginCaptures": {
						"1": { "name": "keyword.control.constfile" },
						"3": { "name": "punctuation.definition.block.constfile" }
					},
					"end": "\\}",
					"endCaptures": {
						"0": { "name": "punctuation.definition.block.constfile" }
					},
					"patterns": [
						{
							"comment": "KEY=VALUE entry (single-line comma-separated and multi-line forms)",
							"name": "meta.env-entry.constfile",
							"match": "([A-Za-z_][A-Za-z0-9_]*)(\\s*)(=)(\\s*)([^,\\n}]*)(,?)",
							"captures": {
								"1": { "name": "variable.other.readwrite.constfile" },
								"3": { "name": "keyword.operator.assignment.constfile" },
								"5": { "name": "string.interpolated.constfile" },
								"6": { "name": "punctuation.separator.comma.constfile" }
							}
						},
						{ "include": "#comments" },
						{ "include": "#var-ref" },
						{ "include": "#env-ref" },
						{ "include": "#strings" }
					]
				},
				{
					"comment": "onfail { ... } cleanup block",
					"name": "meta.block.onfail.constfile",
					"begin": "^\\s*(onfail)(\\s*)(\\{)",
					"beginCaptures": {
						"1": { "name": "keyword.control.constfile" },
						"3": { "name": "punctuation.definition.block.constfile" }
					},
					"end": "\\}",
					"endCaptures": {
						"0": { "name": "punctuation.definition.block.constfile" }
					},
					"patterns": [
						{ "include": "#body-content" }
					]
				},
				{
					"comment": "invoke <command> — keyword plus highlighted target name. Stops at the target so a trailing 'as <name>' capture falls to the as-tag pattern.",
					"match": "^\\s*(invoke)(\\s+)([A-Za-z_][A-Za-z0-9_.-]*)",
					"captures": {
						"1": { "name": "keyword.control.constfile" },
						"3": { "name": "entity.name.type.constfile" }
					}
				},
				{ "include": "#keywords" },
				{ "include": "#error-tolerant-prefix" },
				{ "include": "#operators" },
				{ "include": "#shell-prefix" },
				{ "include": "#comments" },
				{ "include": "#strings" },
				{ "include": "#var-ref" },
				{ "include": "#env-ref" },
				{ "include": "#numbers" },
				{
					"name": "punctuation.definition.block.constfile",
					"match": "[{}]"
				},
				{
					"comment": "Body text — shell commands, paths, flags. Stops before 'as <name>' tag.",
					"name": "string.unquoted.constfile",
					"match": "[^{}\\s][^{}]*?(?=\\s+as\\s+[A-Za-z_][A-Za-z0-9_]*\\s*$|$)"
				}
			]
		},
		"value-content": {
			"patterns": [
				{ "include": "#env-ref" },
				{ "include": "#var-ref" },
				{
					"comment": "$ prefix in a variable value creates a lazy command.",
					"name": "keyword.operator.shell.constfile",
					"match": "(\\$)"
				},
				{ "include": "#strings" },
				{ "include": "#numbers" }
			]
		}
	},
	"scopeName": "source.constfile"
}
