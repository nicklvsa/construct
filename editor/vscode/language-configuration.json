{
	"comments": {
		"lineComment": "#",
		"blockComment": ["//", ""]
	},
	"brackets": [
		["{", "}"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] }
	],
	"surroundingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"" }
	],
	"folding": {
		"markers": {
			"start": "^\\s*\\w.*\\{\\s*$",
			"end": "^\\s*\\}\\s*$"
		}
	},
	"indentationRules": {
		"increaseIndentPattern": "^.*(\\{[^}\"']*)$",
		"decreaseIndentPattern": "^\\s*\\}"
	}
}
