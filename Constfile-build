# Builds the construct-lsp language server binary for the current platform.
build-lsp in editor/vscode/server {
    rm<kill> construct-lsp construct-lsp.exe construct-lsp.exe~
    var win = env("OS")
    env { SUFFIX= }
    if "&win" == "Windows_NT" {
        env { SUFFIX=.exe }
    }
    $ go build -o construct-lsp@SUFFIX .
}

# Builds the actual construct binary
manual build-construct { 
    $ go build -o construct .
}

# Installs the extension's npm dependencies.
install in editor/vscode {
    retry<2, 1s> $ npm install --silent
}

# Packages and installs the host-platform extension. The server binary is
# stashed out of the package (the dev marker points at this copy) and put
# back afterwards.
build-ext in editor/vscode < build-lsp, install {
    var vsix_version = $ cd editor/vscode && node -p "require('./package.json').version"
    onfail {
        ! $ mv server/construct-lsp.exe.stash server/construct-lsp.exe
        ! $ mv server/construct-lsp.stash server/construct-lsp
    }
    ! $ mv server/construct-lsp.exe server/construct-lsp.exe.stash
    ! $ mv server/construct-lsp server/construct-lsp.stash
    timeout 10m $ npx @vscode/vsce@latest package --no-yarn
    ! $ mv server/construct-lsp.exe.stash server/construct-lsp.exe
    ! $ mv server/construct-lsp.stash server/construct-lsp
    $ code --install-extension constfile-&vsix_version.vsix --force as final_out
}

# Cross-compiles construct-lsp and packages the extension for every target
# (darwin/win32/linux x x64/arm64).
manual build-all < install {
    matrix goos in darwin, linux, windows; arch in amd64, arm64 {
        env {
            SUFFIX=
            VSCEOS=darwin
            VSCEARCH=arm64
        }
        if "&goos" == "windows" {
            env { SUFFIX=.exe, VSCEOS=win32 }
        } else if "&goos" == "linux" {
            env { VSCEOS=linux }
        }
        if "&arch" == "amd64" {
            env { VSCEARCH=x64 }
        }
        $ echo "==> @VSCEOS-@VSCEARCH (GOOS=&goos GOARCH=&arch)"
        rm<kill> editor/vscode/server/construct-lsp editor/vscode/server/construct-lsp.exe
        in editor/vscode/server {
            env { GOOS=&goos, GOARCH=&arch }
            timeout 5m $ go build -o construct-lsp@SUFFIX .
        }
        in editor/vscode {
            timeout 10m $ npx @vscode/vsce@latest package --target "@VSCEOS-@VSCEARCH" --no-yarn
        }
    }
}

_ < build-ext {
    echo "&build-ext.final_out"
    echo "reminder: reload open VS Code windows (Cmd+Shift+P -> 'Reload Window') to pick up the new grammar/server — same-version installs do not hot-reload"
}
