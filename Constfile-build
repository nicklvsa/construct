hello {
    $ echo "hello, world" as out
}

build-lsp in editor/vscode/server {
    $ go build -o construct-lsp .
}

build-ext < hello, build-lsp in editor/vscode {
    $ npm install --silent
    $ npm run compile
    $ npx @vscode/vsce@latest package --no-git-tag-version
    $ code --install-extension constfile-0.2.0.vsix --force
    echo "&hello.out"
}
